 911:Tests/spif_tests/spif_tests.c **** /* An access that would run past its page / sector must be shortened, not rejected or wrapped */
 912:Tests/spif_tests/spif_tests.c **** static bool test_write_clamping(void)
 913:Tests/spif_tests/spif_tests.c **** {

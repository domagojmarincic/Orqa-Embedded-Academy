 833:Tests/spif_tests/spif_tests.c **** 
 834:Tests/spif_tests/spif_tests.c ****     /* the reference writes in the upper half, the driver reads back */
 835:Tests/spif_tests/spif_tests.c ****     fill_pattern(64, 0x70);

1008:Tests/spif_tests/spif_tests.c **** /* A read keeps streaming while CS is low, so it may cross page and sector boundaries */
1009:Tests/spif_tests/spif_tests.c **** static bool test_read_across_sectors(void)
1010:Tests/spif_tests/spif_tests.c **** {
1011:Tests/spif_tests/spif_tests.c ****     uint32_t seam = TEST_AREA_ADDRESS(TEST_SECTOR_FOR_SEAM) + REF_SECTOR_SIZE;
1012:Tests/spif_tests/spif_tests.c **** 
1013:Tests/spif_tests/spif_tests.c ****     /* the reference puts 64 bytes on each side of the sector boundary */
1014:Tests/spif_tests/spif_tests.c ****     fill_pattern(128, 0xC0);
1015:Tests/spif_tests/spif_tests.c ****     if (!ref_write(seam - 64, tx_buf, 128))
1016:Tests/spif_tests/spif_tests.c ****     {

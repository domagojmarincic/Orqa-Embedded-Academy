1018:Tests/spif_tests/spif_tests.c ****     }
1019:Tests/spif_tests/spif_tests.c ****     memset(rx_buf, 0, sizeof(rx_buf));
1020:Tests/spif_tests/spif_tests.c ****     if (!spif_read_address(&spif, seam - 64, rx_buf, 128))
1021:Tests/spif_tests/spif_tests.c ****     {
1022:Tests/spif_tests/spif_tests.c ****         return false;
1023:Tests/spif_tests/spif_tests.c ****     }
1024:Tests/spif_tests/spif_tests.c ****     return compare_pattern(128, 0xC0);
1025:Tests/spif_tests/spif_tests.c **** }

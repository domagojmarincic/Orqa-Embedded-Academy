 484:Tests/spif_tests/spif_tests.c **** 
 485:Tests/spif_tests/spif_tests.c **** /* Check that an area reads back as 0xFF, always through the reference */
 486:Tests/spif_tests/spif_tests.c **** static bool is_blank(uint32_t address, uint32_t size)
 487:Tests/spif_tests/spif_tests.c **** {
 488:Tests/spif_tests/spif_tests.c ****     while (size > 0)
 489:Tests/spif_tests/spif_tests.c ****     {
 490:Tests/spif_tests/spif_tests.c ****         uint16_t chunk = (size > TEST_BUF_SIZE) ? TEST_BUF_SIZE : (uint16_t)size;
 491:Tests/spif_tests/spif_tests.c ****         if (!ref_read(address, rx_buf, chunk))
 492:Tests/spif_tests/spif_tests.c ****         {
 493:Tests/spif_tests/spif_tests.c ****             printf("         reference read failed at 0x%08lX\r\n", (unsigned long)address);
 494:Tests/spif_tests/spif_tests.c ****             return false;
 495:Tests/spif_tests/spif_tests.c ****         }
 496:Tests/spif_tests/spif_tests.c ****         for (uint32_t i = 0; i < chunk; i++)
 497:Tests/spif_tests/spif_tests.c ****         {
 498:Tests/spif_tests/spif_tests.c ****             if (rx_buf[i] != 0xFF)
 499:Tests/spif_tests/spif_tests.c ****             {
 500:Tests/spif_tests/spif_tests.c ****                 printf("         not blank at 0x%08lX: 0x%02X\r\n",
 501:Tests/spif_tests/spif_tests.c ****                        (unsigned long)(address + i), rx_buf[i]);
 502:Tests/spif_tests/spif_tests.c ****                 return false;
 503:Tests/spif_tests/spif_tests.c ****             }
 504:Tests/spif_tests/spif_tests.c ****         }
 505:Tests/spif_tests/spif_tests.c ****         address += chunk;
 506:Tests/spif_tests/spif_tests.c ****         size -= chunk;
 507:Tests/spif_tests/spif_tests.c ****     }
 508:Tests/spif_tests/spif_tests.c ****     return true;
 509:Tests/spif_tests/spif_tests.c **** }

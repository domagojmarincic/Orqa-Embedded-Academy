 819:Tests/spif_tests/spif_tests.c ****     fill_pattern(64, 0x30);
 820:Tests/spif_tests/spif_tests.c ****     if (!spif_write_sector(&spif, sector, tx_buf, 64, 0x100))
 821:Tests/spif_tests/spif_tests.c ****     {

 732:Tests/spif_tests/spif_tests.c **** /*-------------------------------------------------------------------------------------------------
 733:Tests/spif_tests/spif_tests.c **** 
 734:Tests/spif_tests/spif_tests.c **** /* 200 bytes across a page boundary, which exercises the paging loop in both directions */
 735:Tests/spif_tests/spif_tests.c **** static bool test_write_read_address(void)
 736:Tests/spif_tests/spif_tests.c **** {
 737:Tests/spif_tests/spif_tests.c ****     uint32_t base = TEST_AREA_ADDRESS(TEST_SECTOR_FOR_ADDRESS);
 738:Tests/spif_tests/spif_tests.c **** 
 739:Tests/spif_tests/spif_tests.c ****     /* the driver writes, the reference reads back */
 740:Tests/spif_tests/spif_tests.c ****     fill_pattern(200, 0x10);
 741:Tests/spif_tests/spif_tests.c ****     if (!spif_write_address(&spif, base + 0xF0, tx_buf, 200))
 742:Tests/spif_tests/spif_tests.c ****     {
 743:Tests/spif_tests/spif_tests.c ****         return false;
 744:Tests/spif_tests/spif_tests.c ****     }
 745:Tests/spif_tests/spif_tests.c ****     memset(rx_buf, 0, sizeof(rx_buf));
 746:Tests/spif_tests/spif_tests.c ****     if (!ref_read(base + 0xF0, rx_buf, 200))
 747:Tests/spif_tests/spif_tests.c ****     {
 748:Tests/spif_tests/spif_tests.c ****         return false;
 749:Tests/spif_tests/spif_tests.c ****     }
 750:Tests/spif_tests/spif_tests.c ****     if (!compare_pattern(200, 0x10))
 751:Tests/spif_tests/spif_tests.c ****     {
 752:Tests/spif_tests/spif_tests.c ****         return false;
 753:Tests/spif_tests/spif_tests.c ****     }
 754:Tests/spif_tests/spif_tests.c **** 
 755:Tests/spif_tests/spif_tests.c ****     /* the reference writes, the driver reads back */
 756:Tests/spif_tests/spif_tests.c ****     fill_pattern(200, 0x50);
 757:Tests/spif_tests/spif_tests.c ****     if (!ref_write(base + TEST_REF_HALF + 0xF0, tx_buf, 200))
 758:Tests/spif_tests/spif_tests.c ****     {
 759:Tests/spif_tests/spif_tests.c ****         return false;
 760:Tests/spif_tests/spif_tests.c ****     }
 761:Tests/spif_tests/spif_tests.c ****     memset(rx_buf, 0, sizeof(rx_buf));
 762:Tests/spif_tests/spif_tests.c ****     if (!spif_read_address(&spif, base + TEST_REF_HALF + 0xF0, rx_buf, 200))
 763:Tests/spif_tests/spif_tests.c ****     {
 764:Tests/spif_tests/spif_tests.c ****         return false;
ARM GAS  C:\Users\Domagoj\AppData\Local\Temp\ccTw9zRk.s 			page 60


 765:Tests/spif_tests/spif_tests.c ****     }
 766:Tests/spif_tests/spif_tests.c ****     return compare_pattern(200, 0x50);
 767:Tests/spif_tests/spif_tests.c **** }
 768:Tests/spif_tests/spif_tests.c **** 
 769:Tests/spif_tests/spif_tests.c **** /*-------------------------------------------------------------------------------------------------
 770:Tests/spif_tests/spif_tests.c **** 
 771:Tests/spif_tests/spif_tests.c **** static bool test_write_read_page(void)
 772:Tests/spif_tests/spif_tests.c **** {
 773:Tests/spif_tests/spif_tests.c ****     uint32_t base = TEST_AREA_ADDRESS(TEST_SECTOR_FOR_PAGE);
 774:Tests/spif_tests/spif_tests.c ****     uint32_t page = base / REF_PAGE_SIZE;
 775:Tests/spif_tests/spif_tests.c **** 
 776:Tests/spif_tests/spif_tests.c ****     /* the driver writes at offset 0x10, the reference reads back */
 777:Tests/spif_tests/spif_tests.c ****     fill_pattern(32, 0x20);
 778:Tests/spif_tests/spif_tests.c ****     if (!spif_write_page(&spif, page, tx_buf, 32, 0x10))
 779:Tests/spif_tests/spif_tests.c ****     {
 780:Tests/spif_tests/spif_tests.c ****         return false;
 781:Tests/spif_tests/spif_tests.c ****     }
 782:Tests/spif_tests/spif_tests.c ****     memset(rx_buf, 0, sizeof(rx_buf));
 783:Tests/spif_tests/spif_tests.c ****     if (!ref_read(base + 0x10, rx_buf, 32))
 784:Tests/spif_tests/spif_tests.c ****     {
 785:Tests/spif_tests/spif_tests.c ****         return false;
 786:Tests/spif_tests/spif_tests.c ****     }
 787:Tests/spif_tests/spif_tests.c ****     if (!compare_pattern(32, 0x20))
 788:Tests/spif_tests/spif_tests.c ****     {
 789:Tests/spif_tests/spif_tests.c ****         return false;
 790:Tests/spif_tests/spif_tests.c ****     }
 791:Tests/spif_tests/spif_tests.c **** 
 792:Tests/spif_tests/spif_tests.c ****     /* the reference writes at offset 0x80, the driver reads back */
 793:Tests/spif_tests/spif_tests.c ****     fill_pattern(32, 0x60);
 794:Tests/spif_tests/spif_tests.c ****     if (!ref_write(base + 0x80, tx_buf, 32))
 795:Tests/spif_tests/spif_tests.c ****     {
 796:Tests/spif_tests/spif_tests.c ****         return false;
 797:Tests/spif_tests/spif_tests.c ****     }
 798:Tests/spif_tests/spif_tests.c ****     memset(rx_buf, 0, sizeof(rx_buf));
 799:Tests/spif_tests/spif_tests.c ****     if (!spif_read_page(&spif, page, rx_buf, 32, 0x80))
 800:Tests/spif_tests/spif_tests.c ****     {
 801:Tests/spif_tests/spif_tests.c ****         return false;
 802:Tests/spif_tests/spif_tests.c ****     }
 803:Tests/spif_tests/spif_tests.c ****     if (!compare_pattern(32, 0x60))
 804:Tests/spif_tests/spif_tests.c ****     {
 805:Tests/spif_tests/spif_tests.c ****         return false;
 806:Tests/spif_tests/spif_tests.c ****     }
 807:Tests/spif_tests/spif_tests.c ****     /* nothing may have leaked into the gap between the two areas */
 808:Tests/spif_tests/spif_tests.c ****     return is_blank(base + 0x30, 0x50);
 809:Tests/spif_tests/spif_tests.c **** }
 810:Tests/spif_tests/spif_tests.c **** 
 811:Tests/spif_tests/spif_tests.c **** /*-------------------------------------------------------------------------------------------------
 812:Tests/spif_tests/spif_tests.c **** 
 813:Tests/spif_tests/spif_tests.c **** static bool test_write_read_sector(void)
 814:Tests/spif_tests/spif_tests.c **** {
 815:Tests/spif_tests/spif_tests.c ****     uint32_t base = TEST_AREA_ADDRESS(TEST_SECTOR_FOR_SECTOR);

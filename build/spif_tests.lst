 387:Tests/spif_tests/spif_tests.c **** /*-------------------------------------------------------------------------------------------------
 388:Tests/spif_tests/spif_tests.c **** 
 389:Tests/spif_tests/spif_tests.c **** /* Programs across page boundaries, one page program command per page */
 390:Tests/spif_tests/spif_tests.c **** static bool ref_write(uint32_t address, const uint8_t *data, uint16_t size)
 391:Tests/spif_tests/spif_tests.c **** {
 392:Tests/spif_tests/spif_tests.c ****     while (size > 0)
 393:Tests/spif_tests/spif_tests.c ****     {
 394:Tests/spif_tests/spif_tests.c ****         uint16_t chunk = (uint16_t)(REF_PAGE_SIZE - (address % REF_PAGE_SIZE));
 395:Tests/spif_tests/spif_tests.c ****         bool ret_val;
 396:Tests/spif_tests/spif_tests.c **** 
 397:Tests/spif_tests/spif_tests.c ****         if (chunk > size)
 398:Tests/spif_tests/spif_tests.c ****         {
 399:Tests/spif_tests/spif_tests.c ****             chunk = size;
 400:Tests/spif_tests/spif_tests.c ****         }
 401:Tests/spif_tests/spif_tests.c ****         if (!ref_command(REF_CMD_WRITE_ENABLE))
 402:Tests/spif_tests/spif_tests.c ****         {
ARM GAS  C:\Users\Domagoj\AppData\Local\Temp\ccTw9zRk.s 			page 10


 403:Tests/spif_tests/spif_tests.c ****             return false;
 404:Tests/spif_tests/spif_tests.c ****         }
 405:Tests/spif_tests/spif_tests.c ****         ref_cs(true);
 406:Tests/spif_tests/spif_tests.c ****         ret_val = ref_command_address(REF_CMD_PAGE_PROG_3A, REF_CMD_PAGE_PROG_4A, address);
 407:Tests/spif_tests/spif_tests.c ****         if (ret_val)
 408:Tests/spif_tests/spif_tests.c ****         {
 409:Tests/spif_tests/spif_tests.c ****             ret_val = ref_transmit(data, chunk);
 410:Tests/spif_tests/spif_tests.c ****         }
 411:Tests/spif_tests/spif_tests.c ****         ref_cs(false);
 412:Tests/spif_tests/spif_tests.c ****         if ((!ret_val) || (!ref_wait_ready(REF_TIMEOUT)))
 413:Tests/spif_tests/spif_tests.c ****         {
 414:Tests/spif_tests/spif_tests.c ****             return false;
 415:Tests/spif_tests/spif_tests.c ****         }
 416:Tests/spif_tests/spif_tests.c ****         address += chunk;
 417:Tests/spif_tests/spif_tests.c ****         data += chunk;
 418:Tests/spif_tests/spif_tests.c ****         size = (uint16_t)(size - chunk);
 419:Tests/spif_tests/spif_tests.c ****     }
 420:Tests/spif_tests/spif_tests.c ****     return true;
 421:Tests/spif_tests/spif_tests.c **** }

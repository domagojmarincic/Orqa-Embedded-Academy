 822:Tests/spif_tests/spif_tests.c ****         return false;
 823:Tests/spif_tests/spif_tests.c ****     }
 824:Tests/spif_tests/spif_tests.c ****     memset(rx_buf, 0, sizeof(rx_buf));
 825:Tests/spif_tests/spif_tests.c ****     if (!ref_read(base + 0x100, rx_buf, 64))
 826:Tests/spif_tests/spif_tests.c ****     {
 827:Tests/spif_tests/spif_tests.c ****         return false;
 828:Tests/spif_tests/spif_tests.c ****     }
